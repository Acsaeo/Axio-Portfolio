---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--line)] py-12 text-center text-sm text-[var(--white-icon)]">
  <span>Built and operated by Axiolus · © {year}</span>

  <span class="mx-2 text-[var(--line)]" aria-hidden="true">·</span>

  
  <span class="mx-2 text-[var(--line)]" aria-hidden="true">·</span>

  <a
    href="https://ko-fi.com/axim"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1.5 rounded-full border border-[var(--sec)] px-3 py-1 text-xs text-[var(--sec)] transition hover:bg-[var(--sec)] hover:text-black"
    aria-label="Support Axiolus on Ko-fi"
  >
    <span aria-hidden="true">☕</span>
    Support on Ko-fi
  </a>

  <a
    href="/portfolio/imprint/"
    class="inline-flex text-xs text-[var(--white-icon)] underline decoration-[var(--sec)] decoration-1 underline-offset-4 transition hover:text-[var(--sec)] hover:decoration-2"
  >
    Impressum
  </a>
</footer>
