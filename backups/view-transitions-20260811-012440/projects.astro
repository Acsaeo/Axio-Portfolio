<section id="projects" class="py-24 border-t border-[var(--line)]"><div class="max-w-5xl mx-auto"><p class="text-[var(--sec)] text-sm tracking-[.18em]">WHAT I’M BUILDING</p><h2 class="text-4xl md:text-5xl mt-2">Projects</h2><div id="axiolus-featured" class="grid md:grid-cols-3 gap-4 mt-9"></div><div class="flex justify-between items-end mt-16"><div><p class="text-[var(--sec)] text-sm tracking-[.18em]">AUTOMATIC FEED</p><h3 class="text-3xl mt-2">Public GitHub</h3></div><a href="/portfolio/projects/" class="text-[var(--sec)]">All projects ↗</a></div><div id="axiolus-github" class="grid md:grid-cols-2 gap-4 mt-8"></div></div>

</section>
<script>const base='/portfolio/';const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const status=p=>`<a href="${base}project/${encodeURIComponent(p.id)}/" class="block rounded-2xl border border-[var(--line)] bg-black p-5 hover:border-[var(--sec)] hover:-translate-y-1 transition" aria-label="Open ${e(p.title)} project documentation"><p class="text-xs text-[var(--sec)] uppercase">${e(p.status)}</p><h3 class="text-2xl mt-2">${e(p.title)}</h3><p class="mt-3 text-[var(--white-icon)]">${e(p.tagline)}</p><div class="h-1 bg-[#ffffff12] mt-6 overflow-hidden rounded-full" role="progressbar" aria-label="${e(p.title)} progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${e(p.progress)}"><div class="h-full bg-[var(--sec)]" style="width:${e(p.progress)}%"></div></div><p class="mt-2 text-sm">${e(p.progress)}% · ${e(p.next)}</p><p class="mt-5 text-xs text-[var(--sec)]">Open project notes ↗</p></a>`;const repo=r=>`<a class="rounded-2xl border border-[var(--line)] p-5 hover:border-[var(--sec)] transition" target="_blank" rel="noreferrer" href="${e(r.url)}"><p class="text-[var(--sec)] text-sm">${e(r.language||'PROJECT')}</p><h3 class="text-xl mt-2">${e(r.name)} ↗</h3><p class="mt-3 text-[var(--white-icon)]">${e(r.description)}</p></a>`;

const homelabCapabilities = [
  { name: 'Private AI workspace', progress: 70, color: 'var(--sec)' },
  { name: 'Automation workflows', progress: 35, color: 'var(--sec)' },
  { name: 'Personal cloud & media', progress: 95, color: 'var(--sec)' },
  { name: 'Disaster recovery backup', progress: 100, color: 'var(--sec)' },
];

const homelabAverage = Math.round(
  homelabCapabilities.reduce((total, item) => total + item.progress, 0) /
  homelabCapabilities.length
);

const homelab = `<a href="/portfolio/homelab/" class="rounded-2xl border border-[var(--line)] bg-black p-5 hover:border-[var(--sec)] transition md:col-span-3">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <p class="text-[var(--sec)] text-xs tracking-[.16em]">SYSTEM PROJECT</p>
      <h3 class="mt-1 text-2xl">Ax-Homelab</h3>
      <p class="mt-2 text-sm text-[var(--white-icon)]">Personal infrastructure for AI, automation, cloud services, media, sync, and disaster recovery.</p>
    </div>

    <div class="min-w-[180px]">
      <div class="flex justify-between text-xs">
        <span class="text-[var(--white-icon)]">overall</span>
        <span class="text-[var(--sec)]">${homelabAverage}%</span>
      </div>

      <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-[#ffffff12]" role="progressbar" aria-label="Ax-Homelab overall progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${homelabAverage}">
        <div class="h-full bg-[var(--sec)] shadow-[0_0_10px_#ff8a18]" style="width:${homelabAverage}%"></div>
      </div>
    </div>
  </div>

  <div class="mt-5 grid grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
    ${homelabCapabilities.map((item) => `
      <div class="min-w-0">
        <p class="truncate">${item.name}</p>
        <p style="color:${item.color}">${item.progress}%</p>
        <div class="mt-1 h-1 overflow-hidden rounded-full bg-[#ffffff12]" role="progressbar" aria-label="${item.name} progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${item.progress}">
          <div class="h-full" style="width:${item.progress}%;background:${item.color}"></div>
        </div>
      </div>
    `).join('')}
  </div>

  <p class="mt-4 text-xs text-[var(--sec)]">Open system project ↗</p>
</a>`;

Promise.all([fetch(base+'data/project-status.json'),fetch(base+'data/github-projects.json')]).then(async x=>[await x[0].json(),await x[1].json()]).then(([a,b])=>{document.querySelector('#axiolus-featured').innerHTML=a.map(status).join('')+homelab;document.querySelector('#axiolus-github').innerHTML=b.map(repo).join('')||'<p class="text-[var(--white-icon)]">No public projects yet.</p>'})</script>
