---
const year = new Date().getFullYear();
---

<footer class="ax-footer py-12 text-center text-sm text-[var(--white-icon)]">
  <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-3">
    <span>Built and operated by Axiolus · © {year}</span>

    <span class="text-[var(--line)]" aria-hidden="true">·</span>

    <a
      href="https://ko-fi.com/axim"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-full border border-[var(--sec)] px-3 py-1 text-xs text-[var(--sec)] transition hover:bg-[var(--sec)] hover:text-black"
      aria-label="Support Axiolus on Ko-fi"
    >
      <span aria-hidden="true">☕</span>
      Support on Ko-fi
    </a>
  </div>
</footer>
<style>.ax-footer{position:relative;padding-top:5rem}
.ax-footer::before{content:"";position:absolute;top:1.5rem;left:50%;transform:translateX(-50%);
height:3px;width:160px;border-radius:9999px;
background:linear-gradient(90deg,transparent,var(--line) 35%,var(--line) 65%,transparent);opacity:.8}</style>
