---
import LetterGlitch from "../React/LetterGlitch.tsx";
---
<section id="home" class="min-h-[92vh] flex items-center pt-24"><div class="max-w-5xl mx-auto w-full grid lg:grid-cols-[1.35fr_.65fr] gap-12 items-center"><div><p class="tracking-[.25em] text-xs text-[var(--sec)] mb-5">HI, I’M AXIOLUS</p><h1 class="text-5xl md:text-7xl font-medium leading-[.9]">Systems Builder<br/>& Creative<br/><span class="text-[var(--sec)] fire-flicker">Technologist</span></h1><p class="mt-7 max-w-xl text-lg md:text-xl text-[var(--white-icon)]">I build self-owned digital systems—from Android apps and emulator tooling to AI companions, automations, and homelab infrastructure that feels alive.</p><a href="#projects" class="inline-block mt-8 rounded-full border border-[var(--sec)] bg-transparent px-6 py-3 text-[var(--sec)] hover:bg-[var(--sec)] hover:text-[#05090b] transition">Explore projects ↓</a></div><div class="h-[290px] rounded-3xl overflow-hidden border border-[var(--line)]"><LetterGlitch client:load glitchColors={["#ff8a18","#ff4d18","#ffd26a"]} glitchSpeed={38} centerVignette={false} outerVignette={true} smooth={true}/></div></div></section>
