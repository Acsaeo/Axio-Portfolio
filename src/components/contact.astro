<section id="contact" class="py-24 ax-contact"><div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10"><div><p class="text-[var(--sec)] text-sm tracking-[.18em]">LET’S BUILD</p><h2 class="text-4xl md:text-5xl mt-2">Contact</h2><p class="text-[var(--white-icon)] mt-5 max-w-md">Have an idea, collaboration, or project in mind? Send a signal.</p></div><form id="contact-form" class="space-y-4"><input class="ax-input" name="name" required maxlength="100" placeholder="Name"/><input class="ax-input" name="email" required type="email" maxlength="254" placeholder="Email"/><textarea class="ax-input" name="message" required maxlength="4000" rows="6" placeholder="Message"></textarea><input name="website" tabindex="-1" autocomplete="off" class="hidden"/><input name="startedAt" id="startedAt" type="hidden"/><button class="rounded-xl border border-[var(--sec)] px-5 py-3 text-[var(--sec)] hover:bg-[var(--sec)] hover:text-[#05090b] transition" type="submit">Send message</button><p id="contact-status" class="text-sm text-[var(--white-icon)]"></p></form></div></section><style>/* short centered fading separator on top of contact */
.ax-contact{position:relative;padding-top:6rem}
.ax-contact::before{content:"";position:absolute;top:2.5rem;left:50%;transform:translateX(-50%);height:3px;width:160px;border-radius:9999px;background:linear-gradient(90deg,transparent,var(--sec) 35%,var(--sec) 65%,transparent);opacity:.55}
.ax-input{width:100%;border:1px solid var(--line);border-radius:.75rem;background:#000;color:var(--white);padding:.85rem;outline:none}.ax-input:focus{border-color:var(--sec)}</style><script>
const form = document.querySelector<HTMLFormElement>('#contact-form');
const status = document.querySelector<HTMLParagraphElement>('#contact-status');
const startedAt = document.querySelector<HTMLInputElement>('#startedAt');

if (!form || !status || !startedAt) {
  throw new Error('Contact form elements are missing.');
}

startedAt.value = String(Date.now());

form.addEventListener('submit', async (event) => {
  event.preventDefault();
  status.textContent = 'Sending…';

  const response = await fetch('/n8n/webhook/axio-contact', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(Object.fromEntries(new FormData(form))),
  }).catch(() => null);

  if (response?.ok) {
    form.reset();
    status.textContent = 'Signal received. Thank you.';
  } else {
    status.textContent = 'Could not send right now. Please try again later.';
  }
});
</script>
