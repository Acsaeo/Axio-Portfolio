---
import { ClientRouter } from "astro:transitions";
const { title } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | Axiolus</title><meta name="description" content="Axiolus builds self-owned digital systems, Android experiments, AI companions, and homelab infrastructure."/><meta name="robots" content="noindex,nofollow,noarchive,nosnippet"/><meta name="theme-color" content="#05090b"/><link rel="icon" type="image/png" href="/portfolio/axiolus-fire-icon-zoomed.png"/>
<link rel="apple-touch-icon" href="/portfolio/axiolus-fire-icon-zoomed.png"/>

<meta property="og:type" content="website"/>
<meta property="og:site_name" content="Axiolus"/>
<meta property="og:title" content="Axiolus — Systems Builder & Creative Technologist"/>
<meta property="og:description" content="Self-owned digital systems: Android experiments, AI companions, automation, and homelab infrastructure."/>
<meta property="og:url" content="https://ax-server.tailcf3361.ts.net/portfolio/"/>
<meta property="og:image" content="https://ax-server.tailcf3361.ts.net/portfolio/axiolus-og-banner.png"/>
<meta property="og:image:secure_url" content="https://ax-server.tailcf3361.ts.net/portfolio/axiolus-og-banner.png"/>
<meta property="og:image:type" content="image/png"/>
<meta property="og:image:width" content="2896"/>
<meta property="og:image:height" content="1520"/>
<meta property="og:image:alt" content="Axiolus — Systems Builder and Creative Technologist"/>

<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content="Axiolus — Systems Builder & Creative Technologist"/>
<meta name="twitter:description" content="Android experiments, self-hosted AI, automation, and homelab infrastructure."/>
<meta name="twitter:image" content="https://ax-server.tailcf3361.ts.net/portfolio/axiolus-og-banner.png"/>
    <ClientRouter />

<script defer src="https://ax-server.tailcf3361.ts.net:10000/script.js" data-website-id="43f00c5f-3304-4058-ab9d-68913f640e74"></script></head><body class="bg-[var(--background)] sm:px-28 lg:px-20 px-7"><slot/>
<script is:inline>
  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;

    const tile = target.closest("[data-project-tile]");
    if (tile) {
      sessionStorage.setItem(
        "axio-project-return",
        tile.getAttribute("data-project-tile") || "1"
      );
      return;
    }

    const backLink = target.closest("[data-project-back]");
    if (!backLink) return;

    if (sessionStorage.getItem("axio-project-return")) {
      event.preventDefault();
      sessionStorage.removeItem("axio-project-return");
      window.history.back();
    }
  });
</script>


<script is:inline>
  document.addEventListener("astro:before-preparation", (event) => {
    const source = event.sourceElement instanceof Element
      ? event.sourceElement
      : null;

    const projectBackLink = source?.closest("[data-project-back]");
    const isBack = event.direction === "back" || Boolean(projectBackLink);
    const direction = isBack ? "back" : "forward";

    document.documentElement.dataset.axioProjectTransition = direction;

    if (event.newDocument?.documentElement) {
      event.newDocument.documentElement.dataset.axioProjectTransition = direction;
    }
  });
</script>

</body></html>
<style is:global>@font-face{font-family:Mont;src:url('/portfolio/fonts/montserrat-latin-wght-normal.woff2')} :root{--background:#000000;--component-bg:#070707f2;--sec:#ff8a18;--coral:#ff4d18;--white:#fff1df;--white-icon:#ffd6ada8;--white-icon-tr:#ff8a181f;--line:#ff8a182b}*{font-family:Mont,system-ui,sans-serif;box-sizing:border-box;margin:0}*::selection{background:var(--sec);color:var(--background)}html{scroll-behavior:smooth}body{min-height:100vh;background:#000;color:var(--white)}@keyframes ember-pulse{
  0%,100%{
    opacity:1;
    text-shadow:0 0 4px #ff8a18,0 0 14px #ff4d18;
  }
  50%{
    opacity:.88;
    text-shadow:0 0 9px #ffd26a,0 0 26px #ff5a1f,0 0 40px #7d1600;
  }
}
.fire-flicker{
  display:inline-block;
  animation:ember-pulse 3.8s ease-in-out infinite;
}
@media (prefers-reduced-motion:reduce){
  .fire-flicker{animation:none}
}
</style>



<style is:global>
  /* axio-project-transition-timing */
  ::view-transition-group(*) {
    animation-duration: 240ms;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 120ms;
    animation-timing-function: ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 1ms;
    }
  }
</style>
